{
  "name": "better-bbo-convention-card",
  "version": "1.0.0",
  "description": "Browser extension for Bridge Base Online's convention cards: printing that fits, ACBL PDFs, JSON and PDF import and export, open in a tab.",
  "type": "module",
  "license": "Unlicense",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "vite build",
    "build:chrome": "BROWSER=chrome vite build",
    "build:firefox": "BROWSER=firefox vite build",
    "build:edge": "BROWSER=edge vite build",
    "build:safari": "BROWSER=safari vite build",
    "build:all": "npm run build:chrome && npm run build:firefox && npm run build:edge && npm run build:safari",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "package": "scripts/package-stores.sh",
    "icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.8.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@bridge-craftwork/convention-card": "github:bridge-craftwork/convention-card#v0.55.0",
    "webextension-polyfill": "^0.12.0"
  }
}
