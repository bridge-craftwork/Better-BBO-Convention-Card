{
  "manifest_version": 3,
  "name": "Better BBO Convention Card",
  "version": "1.0.0",
  "description": "Print, back up and share your Bridge Base Online convention cards: ACBL PDFs, JSON and PDF import and export, full-size tabs.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Better BBO Convention Card",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webutil.bridgebase.com/v2/acblCCFM/*"
      ],
      "js": [
        "src/ui/listContent.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://webutil.bridgebase.com/v2/acblCCFM/*"
      ],
      "js": [
        "src/ui/listPageWorld.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://webutil.bridgebase.com/v2/acblcc/*",
        "https://webutil.bridgebase.com/v2/v2cc/*",
        "https://webutil.bridgebase.com/v2/cs_render_cc.php*",
        "https://webutil.bridgebase.com/v2/fdcc/*"
      ],
      "js": [
        "src/ui/editorContent.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://webutil.bridgebase.com/v2/acblcc/*"
      ],
      "js": [
        "src/ui/editorPageWorld.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://webutil.bridgebase.com/v2/*"
  ]
}
