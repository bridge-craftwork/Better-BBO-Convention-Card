{
  "manifest_version": 3,
  "name": "Better BBO Convention Card",
  "version": "0.1.0",
  "description": "Better printing, ACBL PDFs, JSON import/export, and open-in-tab for BBO convention cards.",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webutil.bridgebase.com/v2/acblCCFM/*"
      ],
      "js": [
        "src/ui/listContent.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://webutil.bridgebase.com/v2/acblCCFM/*"
      ],
      "js": [
        "src/ui/listPageWorld.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://webutil.bridgebase.com/v2/acblcc/*",
        "https://webutil.bridgebase.com/v2/v2cc/*",
        "https://webutil.bridgebase.com/v2/cs_render_cc.php*",
        "https://webutil.bridgebase.com/v2/fdcc/*"
      ],
      "js": [
        "src/ui/editorContent.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://webutil.bridgebase.com/*",
    "https://www.bridgebase.com/*"
  ]
}
