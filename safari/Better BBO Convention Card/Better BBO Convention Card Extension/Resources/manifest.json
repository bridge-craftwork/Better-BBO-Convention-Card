{
  "manifest_version": 3,
  "name": "Better BBO Convention Card",
  "version": "1.0.0",
  "description": "Print, back up and share your Bridge Base Online convention cards: ACBL PDFs, JSON and PDF import and export.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Better BBO Convention Card",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/listContent.js-loader-DdqtV2lY.js"
      ],
      "matches": [
        "https://webutil.bridgebase.com/v2/acblCCFM/*"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "js": [
        "assets/listPageWorld.js-56-zsnoR.js"
      ],
      "matches": [
        "https://webutil.bridgebase.com/v2/acblCCFM/*"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "js": [
        "assets/editorContent.js-loader-CmWIkhq0.js"
      ],
      "matches": [
        "https://webutil.bridgebase.com/v2/acblcc/*",
        "https://webutil.bridgebase.com/v2/v2cc/*",
        "https://webutil.bridgebase.com/v2/cs_render_cc.php*",
        "https://webutil.bridgebase.com/v2/fdcc/*"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "js": [
        "assets/editorPageWorld.js-C1hVLvtI.js"
      ],
      "matches": [
        "https://webutil.bridgebase.com/v2/acblcc/*"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "js": [
        "assets/classroomContent.js-loader-BgIZiszM.js"
      ],
      "matches": [
        "https://bridge-classroom.org/*",
        "https://bridge-classroom.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://webutil.bridgebase.com/v2/*",
    "https://www.bridgebase.com/v3/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://webutil.bridgebase.com/*"
      ],
      "resources": [
        "assets/acbl-classic-2023-CVgakCVl.pdf",
        "assets/acbl-new-BUR8nEhL.pdf",
        "assets/BarlowCondensed-Regular-u9oSiJc6.ttf",
        "assets/BarlowCondensed-SemiBold-B7YG4rBL.ttf",
        "assets/auth-w0lqCJN6.js",
        "assets/browser-polyfill-CZ_dLIqp.js",
        "assets/classroom-BFFu9rzf.js",
        "assets/bbo-DHHu8kPQ.js",
        "assets/handoff-BMgaJZhX.js",
        "assets/importCard-K8Jl8OVA.js",
        "assets/card-pdf-B32RjqSn.js",
        "assets/migrate-0bHlNDBH.js",
        "assets/ntDefenses-CN4mM3GI.js",
        "assets/checkCard-Ctz5cqfj.js",
        "assets/bbsa-D5zurKPA.js",
        "assets/bridgodexPdf-o5hfnuem.js",
        "assets/acblPdfImport-Db0usl-u.js",
        "assets/PDFButton-BFAvT4C-.js",
        "assets/acblClassicFillPdf-RJi9Fm94.js",
        "assets/listContent.js-D1Z_IYep.js",
        "assets/listPageWorld.js-56-zsnoR.js",
        "assets/editorPageWorld.js-C1hVLvtI.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://webutil.bridgebase.com/*",
        "https://webutil.bridgebase.com/*",
        "https://webutil.bridgebase.com/*",
        "https://webutil.bridgebase.com/*"
      ],
      "resources": [
        "assets/acbl-classic-2023-CVgakCVl.pdf",
        "assets/acbl-new-BUR8nEhL.pdf",
        "assets/BarlowCondensed-Regular-u9oSiJc6.ttf",
        "assets/BarlowCondensed-SemiBold-B7YG4rBL.ttf",
        "assets/browser-polyfill-CZ_dLIqp.js",
        "assets/auth-w0lqCJN6.js",
        "assets/classroom-BFFu9rzf.js",
        "assets/bbo-DHHu8kPQ.js",
        "assets/handoff-BMgaJZhX.js",
        "assets/importCard-K8Jl8OVA.js",
        "assets/card-pdf-B32RjqSn.js",
        "assets/migrate-0bHlNDBH.js",
        "assets/ntDefenses-CN4mM3GI.js",
        "assets/checkCard-Ctz5cqfj.js",
        "assets/bbsa-D5zurKPA.js",
        "assets/bridgodexPdf-o5hfnuem.js",
        "assets/acblPdfImport-Db0usl-u.js",
        "assets/PDFButton-BFAvT4C-.js",
        "assets/acblClassicFillPdf-RJi9Fm94.js",
        "assets/editorContent.js-C_jIBxHe.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://bridge-classroom.com/*",
        "https://bridge-classroom.org/*"
      ],
      "resources": [
        "assets/browser-polyfill-CZ_dLIqp.js",
        "assets/classroom-BFFu9rzf.js",
        "assets/classroomContent.js-CYYb6Zrc.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
